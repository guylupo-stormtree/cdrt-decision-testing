189. 
190.             # Process year/month/day
191.             year, month, day = ymd.resolve_ymd(yearfirst, dayfirst)
192. 
193.             res.century_specified = ymd.century_specified
194.             res.year = year
195.             res.month = month
196.             res.day = day
197. 
198.         except (IndexError, ValueError):
199.             return None, None
200. 
201.         if not info.validate(res):
202.             return None, None
203. 
204.         if fuzzy_with_tokens:
205.             skipped_tokens = self._recombine_skipped(l, skipped_idxs)
