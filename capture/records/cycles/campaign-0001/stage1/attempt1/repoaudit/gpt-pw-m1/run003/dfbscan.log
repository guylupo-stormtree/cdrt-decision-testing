1. def _parse_hms(self, idx, tokens, info, hms_idx):
2.         # TODO: Is this going to admit a lot of false-positives for when we
3.         # just happen to have digits and "h", "m" or "s" characters in non-date
4.         # text?  I guess hex hashes won't have that problem, but there's plenty
5.         # of random junk out there.
6.         if hms_idx is None:
7.             hms = None
8.             new_idx = idx
9.         elif hms_idx > idx:
10.             hms = info.hms(tokens[hms_idx])
11.             new_idx = hms_idx
12.         else:
13.             # Looking backwards, increment one.
14.             hms = info.hms(tokens[hms_idx]) + 1
15.             new_idx = idx
16. 
17.         return (new_idx, hms)
