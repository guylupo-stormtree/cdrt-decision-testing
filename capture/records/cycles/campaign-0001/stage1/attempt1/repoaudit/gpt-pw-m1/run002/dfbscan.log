1. def _parse(self, timestr, dayfirst=None, yearfirst=None, fuzzy=False,
2.                fuzzy_with_tokens=False):
3.         """
4.         Private method which performs the heavy lifting of parsing, called from
5.         ``parse()``, which passes on its ``kwargs`` to this function.
6. 
7.         :param timestr:
8.             The string to parse.
9. 
10.         :param dayfirst:
11.             Whether to interpret the first value in an ambiguous 3-integer date
12.             (e.g. 01/05/09) as the day (``True``) or month (``False``). If
13.             ``yearfirst`` is set to ``True``, this distinguishes between YDM
14.             and YMD. If set to ``None``, this value is retrieved from the
15.             current :class:`parserinfo` object (which itself defaults to
16.             ``False``).
17. 
18.         :param yearfirst:
19.             Whether to interpret the first value in an ambiguous 3-integer date
20.             (e.g. 01/05/09) as the year. If ``True``, the first number is taken
21.             to be the year, otherwise the last number is taken to be the year.
22.             If this is set to ``None``, the value is retrieved from the current
23.             :class:`parserinfo` object (which itself defaults to ``False``).
24. 
25.         :param fuzzy:
26.             Whether to allow fuzzy parsing, allowing for string like "Today is
27.             January 1, 2047 at 8:21:00AM".
28. 
29.         :param fuzzy_with_tokens:
30.             If ``True``, ``fuzzy`` is automatically set to True, and the parser
31.             will return a tuple where the first element is the parsed
32.             :class:`datetime.datetime` datetimestamp and the second element is
33.             a tuple containing the portions of the string which were ignored:
34. 
35.             .. doctest::
36. 
37.                 >>> from dateutil.parser import parse
38.                 >>> parse("Today is January 1, 2047 at 8:21:00AM", fuzzy_with_tokens=True)
39.                 (datetime.datetime(2047, 1, 1, 8, 21), (u'Today is ', u' ', u'at '))
40. 
41.         """
42.         if fuzzy_with_tokens:
43.             fuzzy = True
44. 
45.         info = self.info
46. 
47.         if dayfirst is None:
48.             dayfirst = info.dayfirst
49. 
50.         if yearfirst is None:
51.             yearfirst = info.yearfirst
52. 
53.         res = self._result()
54.         l = _timelex.split(timestr)         # Splits the timestr into tokens
55. 
56.         skipped_idxs = []
57. 
58.         # year/month/day list
59.         ymd = _ymd()
60. 
61.         len_l = len(l)
62.         i = 0
63.         try:
64.             while i < len_l:
65. 
66.                 # Check if it's a number
67.                 value_repr = l[i]
68.                 try:
69.                     value = float(value_repr)
70.                 except ValueError:
71.                     value = None
72. 
73.                 if value is not None:
74.                     # Numeric token
75.                     i = self._parse_numeric_token(l, i, info, ymd, res, fuzzy)
76. 
77.                 # Check weekday
78.                 elif info.weekday(l[i]) is not None:
79.                     value = info.weekday(l[i])
80.                     res.weekday = value
81. 
82.                 # Check month name
83.                 elif info.month(l[i]) is not None:
84.                     value = info.month(l[i])
85.                     ymd.append(value, 'M')
86. 
87.                     if i + 1 < len_l:
88.                         if l[i + 1] in ('-', '/'):
89.                             # Jan-01[-99]
90.                             sep = l[i + 1]
91.                             ymd.append(l[i + 2])
92. 
93.                             if i + 3 < len_l and l[i + 3] == sep:
94.                                 # Jan-01-99
95.                                 ymd.append(l[i + 4])
96.                                 i += 2
97. 
98.                             i += 2
99. 
100.                         elif (i + 4 < len_l and l[i + 1] == l[i + 3] == ' ' and
101.                               info.pertain(l[i + 2])):
102.                             # Jan of 01
103.                             # In this case, 01 is clearly year
104.                             if l[i + 4].isdigit():
105.                                 # Convert it here to become unambiguous
106.                                 value = int(l[i + 4])
107.                                 year = str(info.convertyear(value))
108.                                 ymd.append(year, 'Y')
109.                             else:
110.                                 # Wrong guess
111.                                 pass
112.                                 # TODO: not hit in tests
113.                             i += 4
114. 
115.                 # Check am/pm
116.                 elif info.ampm(l[i]) is not None:
117.                     value = info.ampm(l[i])
118.                     val_is_ampm = self._ampm_valid(res.hour, res.ampm, fuzzy)
119. 
120.                     if val_is_ampm:
121.                         res.hour = self._adjust_ampm(res.hour, value)
122.                         res.ampm = value
123. 
124.                     elif fuzzy:
125.                         skipped_idxs.append(i)
126. 
127.                 # Check for a timezone name
128.                 elif self._could_be_tzname(res.hour, res.tzname, res.tzoffset, l[i]):
129.                     res.tzname = l[i]
130.                     res.tzoffset = info.tzoffset(res.tzname)
131. 
132.                     # Check for something like GMT+3, or BRST+3. Notice
133.                     # that it doesn't mean "I am 3 hours after GMT", but
134.                     # "my time +3 is GMT". If found, we reverse the
135.                     # logic so that timezone parsing code will get it
136.                     # right.
137.                     if i + 1 < len_l and l[i + 1] in ('+', '-'):
138.                         l[i + 1] = ('+', '-')[l[i + 1] == '+']
139.                         res.tzoffset = None
140.                         if info.utczone(res.tzname):
141.                             # With something like GMT+3, the timezone
142.                             # is *not* GMT.
143.                             res.tzname = None
144. 
145.                 # Check for a numbered timezone
146.                 elif res.hour is not None and l[i] in ('+', '-'):
147.                     signal = (-1, 1)[l[i] == '+']
148.                     len_li = len(l[i + 1])
149. 
150.                     # TODO: check that l[i + 1] is integer?
151.                     if len_li == 4:
152.                         # -0300
153.                         hour_offset = int(l[i + 1][:2])
154.                         min_offset = int(l[i + 1][2:])
155.                     elif i + 2 < len_l and l[i + 2] == ':':
156.                         # -03:00
157.                         hour_offset = int(l[i + 1])
158.                         min_offset = int(l[i + 3])  # TODO: Check that l[i+3] is minute-like?
159.                         i += 2
160.                     elif len_li <= 2:
161.                         # -[0]3
162.                         hour_offset = int(l[i + 1][:2])
163.                         min_offset = 0
164.                     else:
165.                         raise ValueError(timestr)
166. 
167.                     res.tzoffset = signal * (hour_offset * 3600 + min_offset * 60)
168. 
169.                     # Look for a timezone name between parenthesis
170.                     if (i + 5 < len_l and
