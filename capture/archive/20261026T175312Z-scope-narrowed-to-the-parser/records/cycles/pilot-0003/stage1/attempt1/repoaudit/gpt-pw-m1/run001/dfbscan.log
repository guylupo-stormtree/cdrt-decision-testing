2.         """Infer the DST offset (the value of dst()) for each transition.
3. 
4.         TZif files give the total UTC offset of each local time type and
5.         whether it is DST, but not how much of the offset is DST, so this has
6.         to be worked out from the standard time on either side of each DST
7.         period. That is done for each transition rather than for each local
8.         time type, because zic reuses a local time type for periods with
9.         different standard offsets (e.g. UTC+0 DST in the Azores was double
10.         summer time in the 1940s and summer time later).
11.         """
12.         n = len(trans_idx)
13. 
14.         # The DST offset implied by the last standard time before and the
15.         # first standard time after each transition. Before the first
16.         # transition, it's the first standard time type, as for _tti_before.
17.         first_std_utcoff = next(
18.             (utcoff for utcoff, dst in zip(utcoffsets, isdsts) if not dst),
19.             None,
20.         )
21.         before = [None] * n
22.         after = [None] * n
23.         for indices, implied, std_utcoff in (
24.             (range(n), before, first_std_utcoff),
25.             (range(n - 1, -1, -1), after, None),
26.         ):
27.             for i in indices:
