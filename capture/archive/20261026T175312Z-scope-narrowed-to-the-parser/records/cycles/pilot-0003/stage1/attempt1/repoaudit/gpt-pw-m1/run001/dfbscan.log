32.                     implied[i] = utcoffsets[idx] - std_utcoff
33. 
34.         # DST offsets where the standard time is the same on both sides
35.         clear_cut = [
36.             (trans_utc[i], before[i])
37.             for i in range(n)
38.             if before[i] and before[i] == after[i]
39.         ]
40. 
41.         dstoffs = [0] * n
42.         for i in range(n):
43.             if not isdsts[trans_idx[i]]:
44.                 continue
45. 
46.             candidates = {c for c in (before[i], after[i]) if c}
47.             if len(candidates) > 1:
48.                 # The standard offset changed during the DST period. A change
49.                 # from local mean time can give something like 0:34:39, which
50.                 # is not a plausible amount of DST.
51.                 plausible = {c for c in candidates if c % 300 == 0}
52.                 candidates = plausible or candidates
53. 
54.             if len(candidates) > 1:
55.                 # Prefer the amount of DST the zone used around the same
56.                 # time, e.g. Tehran used 1:00 and Rarotonga 0:30, though the
57.                 # TZif data for Tehran in 1977 and for Rarotonga in 1978 look
58.                 # the same. This has to be local in time, because some zones
59.                 # used different amounts in different eras (e.g. Montevideo
60.                 # used 0:30 in the 1920s and 1:00 later).
61.                 nearby = {
62.                     dstoff
63.                     for ts, dstoff in clear_cut
64.                     if abs(ts - trans_utc[i]) <= _DST_CONSENSUS_WINDOW
65.                 }
66.                 consensus = candidates & nearby
