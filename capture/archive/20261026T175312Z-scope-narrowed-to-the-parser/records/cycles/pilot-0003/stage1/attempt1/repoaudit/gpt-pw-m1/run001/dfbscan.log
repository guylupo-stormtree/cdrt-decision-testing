1. f _utcoff_to_dstoff(trans_idx, trans_utc, utcoffsets, isdsts):
2.         """Infer the DST offset (the value of dst()) for each transition.
3. 
4.         TZif files give the total UTC offset of each local time type and
5.         whether it is DST, but not how much of the offset is DST, so this has
6.         to be worked out from the standard time on either side of each DST
7.         period. That is done for each transition rather than for each local
8.         time type, because zic reuses a local time type for periods with
9.         different standard offsets (e.g. UTC+0 DST in the Azores was double
10.         summer time in the 1940s and summer time later).
11.         """
12.         n = len(trans_idx)
13. 
14.         # The DST offset implied by the last standard time before and the
15.         # first standard time after each transition. Before the first
16.         # transition, it's the first standard time type, as for _tti_before.
17.         first_std_utcoff = next(
18.             (utcoff for utcoff, dst in zip(utcoffsets, isdsts) if not dst),
19.             None,
20.         )
21.         before = [None] * n
22.         after = [None] * n
23.         for indices, implied, std_utcoff in (
24.             (range(n), before, first_std_utcoff),
25.             (range(n - 1, -1, -1), after, None),
26.         ):
27.             for i in indices:
28.                 idx = trans_idx[i]
29.                 if not isdsts[idx]:
30.                     std_utcoff = utcoffsets[idx]
31.                 elif std_utcoff is not None:
32.                     implied[i] = utcoffsets[idx] - std_utcoff
33. 
34.         # DST offsets where the standard time is the same on both sides
35.         clear_cut = [
36.             (trans_utc[i], before[i])
37.             for i in range(n)
38.             if before[i] and before[i] == after[i]
39.         ]
40. 
41.         dstoffs = [0] * n
42.         for i in range(n):
43.             if not isdsts[trans_idx[i]]:
44.                 continue
45. 
46.             candidates = {c for c in (before[i], after[i]) if c}
47.             if len(candidates) > 1:
48.                 # The standard offset changed during the DST period. A change
49.                 # from local mean time can give something like 0:34:39, which
50.                 # is not a plausible amount of DST.
51.                 plausible = {c for c in candidates if c % 300 == 0}
52.                 candidates = plausible or candidates
53. 
54.             if len(candidates) > 1:
55.                 # Prefer the amount of DST the zone used around the same
56.                 # time, e.g. Tehran used 1:00 and Rarotonga 0:30, though the
57.                 # TZif data for Tehran in 1977 and for Rarotonga in 1978 look
58.                 # the same. This has to be local in time, because some zones
59.                 # used different amounts in different eras (e.g. Montevideo
60.                 # used 0:30 in the 1920s and 1:00 later).
61.                 nearby = {
62.                     dstoff
63.                     for ts, dstoff in clear_cut
64.                     if abs(ts - trans_utc[i]) <= _DST_CONSENSUS_WINDOW
65.                 }
