173.                             x.time = (int(l[i][:2]) * 3600)
174.                         else:
175.                             return None
176.                         used_idxs.append(i)
177.                         i += 1
178. 
179.                     assert i == len_l or l[i] == ','
180. 
181.                     i += 1
182. 
183.                 assert i >= len_l
184. 
185.         except (IndexError, ValueError, AssertionError):
186.             return None
187. 
188.         unused_idxs = set(range(len_l)).difference(used_idxs)
189.         res.any_unused_tokens = not {l[n] for n in unused_idxs}.issubset({",",":"})
190.         return res
