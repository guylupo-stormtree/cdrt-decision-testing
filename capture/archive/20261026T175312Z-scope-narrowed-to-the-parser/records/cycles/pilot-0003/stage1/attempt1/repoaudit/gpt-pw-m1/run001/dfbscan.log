5.             tzkeyname = text_type("{kn}\\{name}").format(kn=TZKEYNAME, name=name)
6.             with winreg.OpenKey(handle, tzkeyname) as tzkey:
7.                 keydict = valuestodict(tzkey)
8. 
9.         self._std_abbr = keydict["Std"]
10.         self._dst_abbr = keydict["Dlt"]
11. 
12.         self._display = keydict["Display"]
13. 
14.         # See http://ww_winreg.jsiinc.com/SUBA/tip0300/rh0398.htm
15.         tup = struct.unpack("=3l16h", keydict["TZI"])
16.         stdoffset = -tup[0]-tup[1]          # Bias + StandardBias * -1
17.         dstoffset = stdoffset-tup[2]        # + DaylightBias * -1
18.         self._std_offset = datetime.timedelta(minutes=stdoffset)
19.         self._dst_offset = datetime.timedelta(minutes=dstoffset)
20. 
21.         # for the meaning see the win32 TIME_ZONE_INFORMATION structure docs
22.         # http://msdn.microsoft.com/en-us/library/windows/desktop/ms725481(v=vs.85).aspx
23.         (self._stdmonth,
24.          self._stddayofweek,   # Sunday = 0
25.          self._stdweeknumber,  # Last = 5
26.          self._stdhour,
27.          self._stdminute) = tup[4:9]
28. 
29.         (self._dstmonth,
30.          self._dstdayofweek,   # Sunday = 0
31.          self._dstweeknumber,  # Last = 5
32.          self._dsthour,
33.          self._dstminute) = tup[12:17]
34. 
35.         self._dst_base_offset_ = self._dst_offset - self._std_offset
36.         self.hasdst = self._get_hasdst()
